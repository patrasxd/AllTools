{
  "name": "alltools",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist PWA Tools Suite — Sketch & Ink Aesthetic",
  "workspaces": [
    "apps/*",
    "packages/tools/*",
    "packages/ui"
  ],
  "scripts": {
    "start": "npm run dev --workspace=@alltools/shell",
    "dev": "npm run dev --workspace=@alltools/shell",
    "build": "npm run build --workspace=@alltools/shell",
    "typecheck": "tsc -b apps/shell",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "preview": "npm run preview --workspace=@alltools/shell",
    "test": "vitest run packages/tools",
    "install-all": "npm install"
  },
  "keywords": [
    "tools",
    "pwa",
    "utilities",
    "tuner",
    "protractor",
    "qr-code",
    "stopwatch",
    "notes",
    "sketch"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
