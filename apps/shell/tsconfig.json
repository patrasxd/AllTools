{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@alltools/ui": ["../../packages/ui/src"],
      "@alltools/dev-vault": ["../../packages/tools/dev-vault/src"],
      "@alltools/image-studio": ["../../packages/tools/image-studio/src"],
      "@alltools/pdf-suite": ["../../packages/tools/pdf-suite/src"],
      "@alltools/calc-converter": ["../../packages/tools/calc-converter/src"],
      "@alltools/guitar-tuner": ["../../packages/tools/guitar-tuner/src"],
      "@alltools/level-protractor": ["../../packages/tools/level-protractor/src"],
      "@alltools/qr-suite": ["../../packages/tools/qr-suite/src"],
      "@alltools/stopwatch-interval": ["../../packages/tools/stopwatch-interval/src"],
      "@alltools/quick-notes": ["../../packages/tools/quick-notes/src"],
      "@alltools/screen-ruler": ["../../packages/tools/screen-ruler/src"]
    }
  },
  "include": ["src", "../../packages/*/src", "../../packages/tools/*/src"]
}
